# Python
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.python-version
.DS_Store

# Manhwa content - never commit
docs/

# GPU profiles in cache/*.json may be committed; built TensorRT engines never
cache/*
!cache/*.json
cache/trt_engines/

# Temp & logs (we don't want these in Git)
TempExtract/
upscaled/
Log/
*.log

# Big binaries & weights (we'll handle them separately)
Real-ESRGAN/
Real-ESRGAN/weights/*
Real-ESRGAN/experiments/*
*.pth
*.pth.*

# Editor junk
.vscode/
.idea/

# Model weights and downloads
*.safetensors
models/janai_dl/

# Copyrighted pages: never commit, wherever they end up
*.cbz
**/compare_page*.html

# Inputs (the scanlation library and every dataset built from it) and generated results: never commit
/data/
/outputs/
